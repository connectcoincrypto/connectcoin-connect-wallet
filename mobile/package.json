{
  "name": "connectwallet-mobile",
  "version": "1.0.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "ConnectWallet mobile development alpha — native wallet and P2C claims",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build && vite preview --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test --test-timeout=10000 test/*.test.mjs",
    "test:ui": "playwright test",
    "check:android": "node scripts/check-android.mjs",
    "check:ios": "node scripts/check-ios.mjs",
    "test:rpc": "node scripts/probe-rpc.mjs",
    "sync:android": "npm run build && cap sync android",
    "open:android": "cap open android",
    "sync:ios": "npm run build && cap sync ios",
    "open:ios": "cap open ios",
    "build:ios": "bash scripts/build-ios.sh all",
    "test:ios": "bash scripts/build-ios.sh core"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@noble/curves": "2.4.0",
    "@scure/base": "2.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "1.63.0",
    "vite": "8.3.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
