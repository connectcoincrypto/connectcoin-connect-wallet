{
  "name": "connectcoin-connect-wallet",
  "productName": "ConnectWallet",
  "desktopName": "com.connectcoincrypto.connectwallet.desktop",
  "version": "0.1.0",
  "description": "A local-key, light ConnectCoin wallet with BIP39 recovery and Automatic Claims",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "license": "MIT",
  "homepage": "https://connectcoincrypto.com/",
  "author": "ConnectCoin contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/connectcoincrypto/connectcoin-connect-wallet.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-timeout=60000 test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:ui:rsa": "node scripts/test-ui-rsa.mjs",
    "test:ui:load": "node scripts/test-ui-load.mjs",
    "test:ui:recovery": "node scripts/test-ui-recovery.mjs",
    "test:regtest": "node scripts/crypto-regtest.mjs",
    "setup:claims": "node scripts/setup-claims.mjs",
    "build:claims": "node scripts/setup-claims.mjs --build",
    "build:icon": "node scripts/build-icon.mjs",
    "prepack": "node scripts/check-package.mjs",
    "pack": "electron-builder --dir --publish never",
    "dist": "node scripts/build-installers.mjs",
    "dist:win": "node scripts/build-installers.mjs --platform=win32 --arch=x64",
    "dist:mac": "node scripts/build-installers.mjs --platform=darwin",
    "dist:linux": "node scripts/build-installers.mjs --platform=linux --arch=x64"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@xmldom/xmldom": "0.8.15",
    "electron": "44.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.connectcoincrypto.connectwallet",
    "publish": null,
    "msiProjectCreated": "scripts/msi-project.mjs",
    "asar": true,
    "files": [
      "src/**",
      "assets/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "helpers/bin/connectwallet-claims",
        "to": "claims-helper"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "msi"
      ],
      "artifactName": "ConnectWallet-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "guid": "d88d5a21-77b9-537e-98d1-01560f964433",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["en_US"],
      "language": "1033",
      "multiLanguageInstaller": false,
      "displayLanguageSelector": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "shortcutName": "ConnectWallet",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    },
    "msi": {
      "upgradeCode": "67F96C30-665A-4AF6-9A87-B741403A11A5",
      "oneClick": false,
      "perMachine": false,
      "shortcutName": "ConnectWallet",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "additionalLightArgs": ["-cultures:en-us"]
    },
    "linux": {
      "icon": "assets/icon-512.png",
      "executableName": "connectwallet",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "category": "Finance",
      "maintainer": "ConnectCoin Crypto <connectcoincrypto@gmail.com>",
      "vendor": "ConnectCoin Crypto",
      "artifactName": "ConnectWallet-${version}-Linux-x64.${ext}",
      "desktop": {
        "entry": {
          "Name": "ConnectWallet",
          "Comment": "ConnectCoin light wallet",
          "StartupWMClass": "com.connectcoincrypto.connectwallet"
        }
      }
    },
    "deb": {
      "packageName": "connectwallet",
      "recommends": []
    },
    "rpm": {
      "packageName": "connectwallet"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance",
      "artifactName": "ConnectWallet-${version}-macOS-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "extendInfo": {
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "dmg": {
      "title": "ConnectWallet ${version}"
    }
  }
}
